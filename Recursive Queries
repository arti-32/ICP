import java.util.*;
public class Main {
    static int MAXN = 1000000;
    static int[] g = new int[MAXN + 1];
    static int[][] pref = new int[10][MAXN + 1];

    static int f(int x) {
        int prod = 1;
        while (x > 0) {
            int d = x % 10;
            if (d != 0) prod *= d;
            x /= 10;
        }
        return prod;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // precompute g(x)
        for (int i = 1; i < 10; i++) g[i] = i;
        for (int i = 10; i <= MAXN; i++)
            g[i] = g[f(i)];

        // build prefix sums
        for (int i = 1; i <= MAXN; i++) {
            for (int k = 1; k <= 9; k++)
                pref[k][i] = pref[k][i - 1];
            pref[g[i]][i]++;
        }

        int Q = sc.nextInt();
        StringBuilder sb = new StringBuilder();
        while (Q-- > 0) {
            int l = sc.nextInt(), r = sc.nextInt(), k = sc.nextInt();
            sb.append(pref[k][r] - pref[k][l - 1]).append("\n");
        }
        System.out.print(sb);
    }
}
